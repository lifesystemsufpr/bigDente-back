generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERADOR
  ALUNO
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  password String
  refreshTokenHash String?  @map("refresh_token_hash")
  role     Role
  student  Student?

  @@map("users")
}

model Student {
  studentId Int    @id @default(autoincrement()) @map("student_id")
  code      String @unique
  grr       String @unique
  course    String
  userId    Int    @unique @map("user_id")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sterilizationUnits SterilizationUnit[]

  @@map("students")
}

enum SterilizationCase {
  CASE
  PACK
} 

enum SterilizationStatus {
  PENDING
  ERROR
  SUBMITTED
  COMPLETED
  DELIVERED
  CANCELLED
}

model SterilizationUnit {
    id          String @id @default(uuid())
    code        String @unique
    student     Student @relation(fields: [studentId], references: [studentId], onDelete: Cascade) 
    studentId   Int @map("student_id")
    type        SterilizationCase

    submittedForSterilizationAt        DateTime?
    expectedSterilizationDeliveryAt    DateTime?
    sterilizationDeliveredAt           DateTime?

    status      SterilizationStatus   @default(PENDING)

    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@map("sterilization_cases")
}